{% doc %}
  @prompt
    Add an option to edit or remove dummy reviews
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-reviews-container-{{ ai_gen_id }} {
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-reviews-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-reviews-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 10px;
  }

  .ai-reviews-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
  }

  .ai-reviews-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-review-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 24px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-review-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .ai-review-avatar-{{ ai_gen_id }} {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: {{ block.settings.avatar_background }};
    color: {{ block.settings.avatar_text_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 18px;
    flex-shrink: 0;
  }

  .ai-review-author-info-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-review-author-{{ ai_gen_id }} {
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0 0 4px;
    font-size: 16px;
  }

  .ai-review-date-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.text_color }};
    opacity: 0.6;
  }

  .ai-review-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
    margin-bottom: 12px;
  }

  .ai-review-star-{{ ai_gen_id }} {
    color: {{ block.settings.star_color }};
    font-size: 18px;
  }

  .ai-review-star-empty-{{ ai_gen_id }} {
    color: {{ block.settings.star_empty_color }};
    font-size: 18px;
  }

  .ai-review-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    font-size: 15px;
  }

  @media screen and (max-width: 749px) {
    .ai-reviews-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<div class="ai-reviews-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-reviews-header-{{ ai_gen_id }}">
    {%- if block.settings.title != blank -%}
      <h2 class="ai-reviews-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    {%- endif -%}
    {%- if block.settings.subtitle != blank -%}
      <p class="ai-reviews-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
    {%- endif -%}
  </div>

  <div class="ai-reviews-grid-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign review_enabled_key = 'review_' | append: i | append: '_enabled'
        assign review_name_key = 'review_' | append: i | append: '_name'
        assign review_date_key = 'review_' | append: i | append: '_date'
        assign review_rating_key = 'review_' | append: i | append: '_rating'
        assign review_text_key = 'review_' | append: i | append: '_text'

        assign review_enabled = block.settings[review_enabled_key]
        assign review_name = block.settings[review_name_key]
        assign review_date = block.settings[review_date_key]
        assign review_rating = block.settings[review_rating_key]
        assign review_text = block.settings[review_text_key]
      %}

      {% if review_enabled and review_name != blank %}
        <div class="ai-review-card-{{ ai_gen_id }}">
          <div class="ai-review-header-{{ ai_gen_id }}">
            <div class="ai-review-avatar-{{ ai_gen_id }}">
              {{ review_name | slice: 0 | upcase }}
            </div>
            <div class="ai-review-author-info-{{ ai_gen_id }}">
              <h3 class="ai-review-author-{{ ai_gen_id }}">{{ review_name }}</h3>
              {% if review_date != blank %}
                <p class="ai-review-date-{{ ai_gen_id }}">{{ review_date }}</p>
              {% endif %}
            </div>
          </div>

          <div class="ai-review-stars-{{ ai_gen_id }}">
            {% for star in (1..5) %}
              {% if star <= review_rating %}
                <span class="ai-review-star-{{ ai_gen_id }}">★</span>
              {% else %}
                <span class="ai-review-star-empty-{{ ai_gen_id }}">★</span>
              {% endif %}
            {% endfor %}
          </div>

          {% if review_text != blank %}
            <div class="ai-review-text-{{ ai_gen_id }}">{{ review_text }}</div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Customer reviews",
  "settings": [
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "What our customers say"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Real reviews from real customers"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Title size",
      "default": 32
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subtitle size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Review 1"
    },
    {
      "type": "checkbox",
      "id": "review_1_enabled",
      "label": "Show review 1",
      "default": true
    },
    {
      "type": "text",
      "id": "review_1_name",
      "label": "Customer name",
      "default": "Sarah Johnson"
    },
    {
      "type": "text",
      "id": "review_1_date",
      "label": "Review date",
      "default": "2 weeks ago"
    },
    {
      "type": "range",
      "id": "review_1_rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Rating",
      "default": 5
    },
    {
      "type": "textarea",
      "id": "review_1_text",
      "label": "Review text",
      "default": "Absolutely love this product! The quality exceeded my expectations and shipping was super fast. Will definitely be ordering again."
    },
    {
      "type": "header",
      "content": "Review 2"
    },
    {
      "type": "checkbox",
      "id": "review_2_enabled",
      "label": "Show review 2",
      "default": true
    },
    {
      "type": "text",
      "id": "review_2_name",
      "label": "Customer name",
      "default": "Michael Chen"
    },
    {
      "type": "text",
      "id": "review_2_date",
      "label": "Review date",
      "default": "1 month ago"
    },
    {
      "type": "range",
      "id": "review_2_rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Rating",
      "default": 5
    },
    {
      "type": "textarea",
      "id": "review_2_text",
      "label": "Review text",
      "default": "Great customer service and the product is exactly as described. Highly recommend to anyone looking for quality."
    },
    {
      "type": "header",
      "content": "Review 3"
    },
    {
      "type": "checkbox",
      "id": "review_3_enabled",
      "label": "Show review 3",
      "default": true
    },
    {
      "type": "text",
      "id": "review_3_name",
      "label": "Customer name",
      "default": "Emma Williams"
    },
    {
      "type": "text",
      "id": "review_3_date",
      "label": "Review date",
      "default": "3 weeks ago"
    },
    {
      "type": "range",
      "id": "review_3_rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Rating",
      "default": 4
    },
    {
      "type": "textarea",
      "id": "review_3_text",
      "label": "Review text",
      "default": "Very satisfied with my purchase. The only reason I'm not giving 5 stars is because I wish it came in more color options."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1d1d1d"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#f9f9f9"
    },
    {
      "type": "color",
      "id": "avatar_background",
      "label": "Avatar background",
      "default": "#d4c4d9"
    },
    {
      "type": "color",
      "id": "avatar_text_color",
      "label": "Avatar text",
      "default": "#1d1d1d"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star filled",
      "default": "#ffc107"
    },
    {
      "type": "color",
      "id": "star_empty_color",
      "label": "Star empty",
      "default": "#e0e0e0"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Card border radius",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Customer reviews"
    }
  ]
}
{% endschema %}