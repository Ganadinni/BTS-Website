{% doc %}
  @prompt
    Please create the Bulk Order Request Form based on the Quick-Reference Summary. Ensure the form has conditional logic for the 'Occasion' and 'Product Selection' fields, strictly enforces a minimum quantity of 10, and is configured to send immediate notifications via both email (with full data) and a concise WhatsApp message upon every submission.", Add left and right padding, remove the grey box at the top and bottom, remove form border , Add top and bottom padding 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-bulk-order-form-wrapper-{{ ai_gen_id }} {
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    padding-left: {{ block.settings.padding_left }}px;
    padding-right: {{ block.settings.padding_right }}px;
  }

  .ai-bulk-order-form-{{ ai_gen_id }} {
    max-width: 800px;
    margin: 0 auto;
  }

  .ai-bulk-order-form__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 12px;
    text-align: center;
  }

  .ai-bulk-order-form__description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    text-align: center;
    margin: 0 0 32px;
    font-size: 16px;
  }

  .ai-bulk-order-form__field-group-{{ ai_gen_id }} {
    margin-bottom: 24px;
  }

  .ai-bulk-order-form__label-{{ ai_gen_id }} {
    display: block;
    color: {{ block.settings.label_color }};
    font-weight: 600;
    margin-bottom: 8px;
    font-size: 14px;
  }

  .ai-bulk-order-form__required-{{ ai_gen_id }} {
    color: {{ block.settings.error_color }};
    margin-left: 4px;
  }

  .ai-bulk-order-form__input-{{ ai_gen_id }},
  .ai-bulk-order-form__select-{{ ai_gen_id }},
  .ai-bulk-order-form__textarea-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    font-size: 14px;
    background-color: #ffffff;
    color: #1d1d1d;
    box-sizing: border-box;
  }

  .ai-bulk-order-form__input-{{ ai_gen_id }}:focus,
  .ai-bulk-order-form__select-{{ ai_gen_id }}:focus,
  .ai-bulk-order-form__textarea-{{ ai_gen_id }}:focus {
    outline: none;
    border-color: {{ block.settings.input_focus_color }};
  }

  .ai-bulk-order-form__textarea-{{ ai_gen_id }} {
    min-height: 100px;
    resize: vertical;
  }

  .ai-bulk-order-form__error-{{ ai_gen_id }} {
    color: {{ block.settings.error_color }};
    font-size: 12px;
    margin-top: 4px;
    display: none;
  }

  .ai-bulk-order-form__error-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-bulk-order-form__info-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.info_text_color }};
    margin-top: 4px;
  }

  .ai-bulk-order-form__conditional-{{ ai_gen_id }} {
    display: none;
  }

  .ai-bulk-order-form__conditional-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-bulk-order-form__product-list-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 12px;
    margin-top: 12px;
  }

  .ai-bulk-order-form__product-item-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-bulk-order-form__checkbox-wrapper-{{ ai_gen_id }} {
    position: relative;
    cursor: pointer;
  }

  .ai-bulk-order-form__product-checkbox-{{ ai_gen_id }} {
    position: absolute;
    opacity: 0;
    cursor: pointer;
  }

  .ai-bulk-order-form__product-card-{{ ai_gen_id }} {
    border: 2px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    padding: 12px;
    text-align: center;
    transition: all 0.3s ease;
  }

  .ai-bulk-order-form__product-checkbox-{{ ai_gen_id }}:checked ~ .ai-bulk-order-form__product-card-{{ ai_gen_id }} {
    border-color: {{ block.settings.input_focus_color }};
    background-color: {{ block.settings.selected_product_bg }};
  }

  .ai-bulk-order-form__product-image-{{ ai_gen_id }} {
    width: 100%;
    height: 120px;
    object-fit: cover;
    border-radius: 8px;
    margin-bottom: 8px;
  }

  .ai-bulk-order-form__product-title-{{ ai_gen_id }} {
    font-size: 13px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-bulk-order-form__submit-{{ ai_gen_id }} {
    width: 100%;
    padding: 16px 32px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-bulk-order-form__submit-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-bulk-order-form__submit-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-bulk-order-form__success-{{ ai_gen_id }} {
    background-color: {{ block.settings.success_bg_color }};
    color: {{ block.settings.success_text_color }};
    padding: 16px;
    border-radius: {{ block.settings.input_border_radius }}px;
    margin-bottom: 24px;
    display: none;
  }

  .ai-bulk-order-form__success-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-bulk-order-form__form-error-{{ ai_gen_id }} {
    background-color: #fef2f2;
    color: {{ block.settings.error_color }};
    padding: 16px;
    border-radius: {{ block.settings.input_border_radius }}px;
    margin-bottom: 24px;
    display: none;
  }

  .ai-bulk-order-form__form-error-{{ ai_gen_id }}.active {
    display: block;
  }

  @media screen and (max-width: 749px) {
    .ai-bulk-order-form-wrapper-{{ ai_gen_id }} {
      padding-top: {{ block.settings.padding_top | times: 0.5 }}px;
      padding-bottom: {{ block.settings.padding_bottom | times: 0.5 }}px;
      padding-left: {{ block.settings.padding_left | times: 0.5 }}px;
      padding-right: {{ block.settings.padding_right | times: 0.5 }}px;
    }

    .ai-bulk-order-form__product-list-{{ ai_gen_id }} {
      grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    }
  }
{% endstyle %}

<div class="ai-bulk-order-form-wrapper-{{ ai_gen_id }}">
  <bulk-order-form-{{ ai_gen_id }}
    class="ai-bulk-order-form-{{ ai_gen_id }}"
    {{ block.shopify_attributes }}
    data-email="{{ block.settings.notification_email }}"
    data-whatsapp="{{ block.settings.whatsapp_number }}"
  >
    {%- if block.settings.form_heading != blank -%}
      <h2 class="ai-bulk-order-form__heading-{{ ai_gen_id }}">{{ block.settings.form_heading }}</h2>
    {%- endif -%}

    {%- if block.settings.form_description != blank -%}
      <div class="ai-bulk-order-form__description-{{ ai_gen_id }}">{{ block.settings.form_description }}</div>
    {%- endif -%}

    <div class="ai-bulk-order-form__success-{{ ai_gen_id }}" id="success-message-{{ ai_gen_id }}">
      {{ block.settings.success_message }}
    </div>

    <div class="ai-bulk-order-form__form-error-{{ ai_gen_id }}" id="form-error-{{ ai_gen_id }}">
      Please correct the errors below and try again.
    </div>

    {%- form 'contact' -%}
      <input type="hidden" name="contact[form_type]" value="Bulk Order Request">

      <div class="ai-bulk-order-form__field-group-{{ ai_gen_id }}">
        <label class="ai-bulk-order-form__label-{{ ai_gen_id }}" for="name-{{ ai_gen_id }}">
          Full Name<span class="ai-bulk-order-form__required-{{ ai_gen_id }}">*</span>
        </label>
        <input
          type="text"
          id="name-{{ ai_gen_id }}"
          name="contact[name]"
          class="ai-bulk-order-form__input-{{ ai_gen_id }}"
          required
          aria-required="true"
        >
        <div class="ai-bulk-order-form__error-{{ ai_gen_id }}" id="name-error-{{ ai_gen_id }}">
          Please enter your full name
        </div>
      </div>

      <div class="ai-bulk-order-form__field-group-{{ ai_gen_id }}">
        <label class="ai-bulk-order-form__label-{{ ai_gen_id }}" for="email-{{ ai_gen_id }}">
          Email Address<span class="ai-bulk-order-form__required-{{ ai_gen_id }}">*</span>
        </label>
        <input
          type="email"
          id="email-{{ ai_gen_id }}"
          name="contact[email]"
          class="ai-bulk-order-form__input-{{ ai_gen_id }}"
          required
          aria-required="true"
        >
        <div class="ai-bulk-order-form__error-{{ ai_gen_id }}" id="email-error-{{ ai_gen_id }}">
          Please enter a valid email address
        </div>
      </div>

      <div class="ai-bulk-order-form__field-group-{{ ai_gen_id }}">
        <label class="ai-bulk-order-form__label-{{ ai_gen_id }}" for="phone-{{ ai_gen_id }}">
          Phone Number<span class="ai-bulk-order-form__required-{{ ai_gen_id }}">*</span>
        </label>
        <input
          type="tel"
          id="phone-{{ ai_gen_id }}"
          name="contact[phone]"
          class="ai-bulk-order-form__input-{{ ai_gen_id }}"
          required
          aria-required="true"
        >
        <div class="ai-bulk-order-form__error-{{ ai_gen_id }}" id="phone-error-{{ ai_gen_id }}">
          Please enter your phone number
        </div>
      </div>

      <div class="ai-bulk-order-form__field-group-{{ ai_gen_id }}">
        <label class="ai-bulk-order-form__label-{{ ai_gen_id }}" for="company-{{ ai_gen_id }}">
          Company Name
        </label>
        <input
          type="text"
          id="company-{{ ai_gen_id }}"
          name="contact[company]"
          class="ai-bulk-order-form__input-{{ ai_gen_id }}"
        >
      </div>

      <div class="ai-bulk-order-form__field-group-{{ ai_gen_id }}">
        <label class="ai-bulk-order-form__label-{{ ai_gen_id }}" for="occasion-{{ ai_gen_id }}">
          Occasion<span class="ai-bulk-order-form__required-{{ ai_gen_id }}">*</span>
        </label>
        <select
          id="occasion-{{ ai_gen_id }}"
          name="contact[occasion]"
          class="ai-bulk-order-form__select-{{ ai_gen_id }}"
          required
          aria-required="true"
        >
          <option value="">Select an occasion</option>
          <option value="Corporate Event">Corporate Event</option>
          <option value="Wedding">Wedding</option>
          <option value="Birthday Party">Birthday Party</option>
          <option value="Festival">Festival</option>
          <option value="School/College Event">School/College Event</option>
          <option value="Other">Other</option>
        </select>
        <div class="ai-bulk-order-form__error-{{ ai_gen_id }}" id="occasion-error-{{ ai_gen_id }}">
          Please select an occasion
        </div>
      </div>

      <div class="ai-bulk-order-form__field-group-{{ ai_gen_id }} ai-bulk-order-form__conditional-{{ ai_gen_id }}" id="occasion-other-{{ ai_gen_id }}">
        <label class="ai-bulk-order-form__label-{{ ai_gen_id }}" for="occasion-other-text-{{ ai_gen_id }}">
          Please specify the occasion<span class="ai-bulk-order-form__required-{{ ai_gen_id }}">*</span>
        </label>
        <input
          type="text"
          id="occasion-other-text-{{ ai_gen_id }}"
          name="contact[occasion_other]"
          class="ai-bulk-order-form__input-{{ ai_gen_id }}"
        >
        <div class="ai-bulk-order-form__error-{{ ai_gen_id }}" id="occasion-other-error-{{ ai_gen_id }}">
          Please specify the occasion
        </div>
      </div>

      <div class="ai-bulk-order-form__field-group-{{ ai_gen_id }}">
        <label class="ai-bulk-order-form__label-{{ ai_gen_id }}" for="event-date-{{ ai_gen_id }}">
          Event Date<span class="ai-bulk-order-form__required-{{ ai_gen_id }}">*</span>
        </label>
        <input
          type="text"
          id="event-date-{{ ai_gen_id }}"
          name="contact[event_date]"
          class="ai-bulk-order-form__input-{{ ai_gen_id }}"
          placeholder="DD/MM/YYYY"
          required
          aria-required="true"
        >
        <div class="ai-bulk-order-form__error-{{ ai_gen_id }}" id="event-date-error-{{ ai_gen_id }}">
          Please enter the event date
        </div>
      </div>

      <div class="ai-bulk-order-form__field-group-{{ ai_gen_id }}">
        <label class="ai-bulk-order-form__label-{{ ai_gen_id }}" for="product-selection-{{ ai_gen_id }}">
          Product Selection<span class="ai-bulk-order-form__required-{{ ai_gen_id }}">*</span>
        </label>
        <select
          id="product-selection-{{ ai_gen_id }}"
          name="contact[product_selection_type]"
          class="ai-bulk-order-form__select-{{ ai_gen_id }}"
          required
          aria-required="true"
        >
          <option value="">Select product selection method</option>
          <option value="Choose from catalog">Choose from catalog</option>
          <option value="Custom requirements">Custom requirements</option>
        </select>
        <div class="ai-bulk-order-form__error-{{ ai_gen_id }}" id="product-selection-error-{{ ai_gen_id }}">
          Please select a product selection method
        </div>
      </div>

      <div class="ai-bulk-order-form__field-group-{{ ai_gen_id }} ai-bulk-order-form__conditional-{{ ai_gen_id }}" id="catalog-products-{{ ai_gen_id }}">
        <label class="ai-bulk-order-form__label-{{ ai_gen_id }}">
          Select Products<span class="ai-bulk-order-form__required-{{ ai_gen_id }}">*</span>
        </label>
        <div class="ai-bulk-order-form__info-{{ ai_gen_id }}">
          Select one or more products from our catalog
        </div>
        <div class="ai-bulk-order-form__product-list-{{ ai_gen_id }}">
          {% if block.settings.product_1 != blank %}
            <div class="ai-bulk-order-form__product-item-{{ ai_gen_id }}">
              <label class="ai-bulk-order-form__checkbox-wrapper-{{ ai_gen_id }}">
                <input
                  type="checkbox"
                  name="contact[product_1]"
                  value="{{ block.settings.product_1.title }}"
                  class="ai-bulk-order-form__product-checkbox-{{ ai_gen_id }}"
                >
                <div class="ai-bulk-order-form__product-card-{{ ai_gen_id }}">
                  {% if block.settings.product_1.featured_image %}
                    <img
                      src="{{ block.settings.product_1.featured_image | image_url: width: 200 }}"
                      alt="{{ block.settings.product_1.featured_image.alt | escape }}"
                      class="ai-bulk-order-form__product-image-{{ ai_gen_id }}"
                      loading="lazy"
                    >
                  {% endif %}
                  <p class="ai-bulk-order-form__product-title-{{ ai_gen_id }}">{{ block.settings.product_1.title }}</p>
                </div>
              </label>
            </div>
          {% endif %}

          {% if block.settings.product_2 != blank %}
            <div class="ai-bulk-order-form__product-item-{{ ai_gen_id }}">
              <label class="ai-bulk-order-form__checkbox-wrapper-{{ ai_gen_id }}">
                <input
                  type="checkbox"
                  name="contact[product_2]"
                  value="{{ block.settings.product_2.title }}"
                  class="ai-bulk-order-form__product-checkbox-{{ ai_gen_id }}"
                >
                <div class="ai-bulk-order-form__product-card-{{ ai_gen_id }}">
                  {% if block.settings.product_2.featured_image %}
                    <img
                      src="{{ block.settings.product_2.featured_image | image_url: width: 200 }}"
                      alt="{{ block.settings.product_2.featured_image.alt | escape }}"
                      class="ai-bulk-order-form__product-image-{{ ai_gen_id }}"
                      loading="lazy"
                    >
                  {% endif %}
                  <p class="ai-bulk-order-form__product-title-{{ ai_gen_id }}">{{ block.settings.product_2.title }}</p>
                </div>
              </label>
            </div>
          {% endif %}

          {% if block.settings.product_3 != blank %}
            <div class="ai-bulk-order-form__product-item-{{ ai_gen_id }}">
              <label class="ai-bulk-order-form__checkbox-wrapper-{{ ai_gen_id }}">
                <input
                  type="checkbox"
                  name="contact[product_3]"
                  value="{{ block.settings.product_3.title }}"
                  class="ai-bulk-order-form__product-checkbox-{{ ai_gen_id }}"
                >
                <div class="ai-bulk-order-form__product-card-{{ ai_gen_id }}">
                  {% if block.settings.product_3.featured_image %}
                    <img
                      src="{{ block.settings.product_3.featured_image | image_url: width: 200 }}"
                      alt="{{ block.settings.product_3.featured_image.alt | escape }}"
                      class="ai-bulk-order-form__product-image-{{ ai_gen_id }}"
                      loading="lazy"
                    >
                  {% endif %}
                  <p class="ai-bulk-order-form__product-title-{{ ai_gen_id }}">{{ block.settings.product_3.title }}</p>
                </div>
              </label>
            </div>
          {% endif %}

          {% if block.settings.product_4 != blank %}
            <div class="ai-bulk-order-form__product-item-{{ ai_gen_id }}">
              <label class="ai-bulk-order-form__checkbox-wrapper-{{ ai_gen_id }}">
                <input
                  type="checkbox"
                  name="contact[product_4]"
                  value="{{ block.settings.product_4.title }}"
                  class="ai-bulk-order-form__product-checkbox-{{ ai_gen_id }}"
                >
                <div class="ai-bulk-order-form__product-card-{{ ai_gen_id }}">
                  {% if block.settings.product_4.featured_image %}
                    <img
                      src="{{ block.settings.product_4.featured_image | image_url: width: 200 }}"
                      alt="{{ block.settings.product_4.featured_image.alt | escape }}"
                      class="ai-bulk-order-form__product-image-{{ ai_gen_id }}"
                      loading="lazy"
                    >
                  {% endif %}
                  <p class="ai-bulk-order-form__product-title-{{ ai_gen_id }}">{{ block.settings.product_4.title }}</p>
                </div>
              </label>
            </div>
          {% endif %}

          {% if block.settings.product_5 != blank %}
            <div class="ai-bulk-order-form__product-item-{{ ai_gen_id }}">
              <label class="ai-bulk-order-form__checkbox-wrapper-{{ ai_gen_id }}">
                <input
                  type="checkbox"
                  name="contact[product_5]"
                  value="{{ block.settings.product_5.title }}"
                  class="ai-bulk-order-form__product-checkbox-{{ ai_gen_id }}"
                >
                <div class="ai-bulk-order-form__product-card-{{ ai_gen_id }}">
                  {% if block.settings.product_5.featured_image %}
                    <img
                      src="{{ block.settings.product_5.featured_image | image_url: width: 200 }}"
                      alt="{{ block.settings.product_5.featured_image.alt | escape }}"
                      class="ai-bulk-order-form__product-image-{{ ai_gen_id }}"
                      loading="lazy"
                    >
                  {% endif %}
                  <p class="ai-bulk-order-form__product-title-{{ ai_gen_id }}">{{ block.settings.product_5.title }}</p>
                </div>
              </label>
            </div>
          {% endif %}

          {% if block.settings.product_6 != blank %}
            <div class="ai-bulk-order-form__product-item-{{ ai_gen_id }}">
              <label class="ai-bulk-order-form__checkbox-wrapper-{{ ai_gen_id }}">
                <input
                  type="checkbox"
                  name="contact[product_6]"
                  value="{{ block.settings.product_6.title }}"
                  class="ai-bulk-order-form__product-checkbox-{{ ai_gen_id }}"
                >
                <div class="ai-bulk-order-form__product-card-{{ ai_gen_id }}">
                  {% if block.settings.product_6.featured_image %}
                    <img
                      src="{{ block.settings.product_6.featured_image | image_url: width: 200 }}"
                      alt="{{ block.settings.product_6.featured_image.alt | escape }}"
                      class="ai-bulk-order-form__product-image-{{ ai_gen_id }}"
                      loading="lazy"
                    >
                  {% endif %}
                  <p class="ai-bulk-order-form__product-title-{{ ai_gen_id }}">{{ block.settings.product_6.title }}</p>
                </div>
              </label>
            </div>
          {% endif %}
        </div>
        <div class="ai-bulk-order-form__error-{{ ai_gen_id }}" id="catalog-products-error-{{ ai_gen_id }}">
          Please select at least one product
        </div>
      </div>

      <div class="ai-bulk-order-form__field-group-{{ ai_gen_id }} ai-bulk-order-form__conditional-{{ ai_gen_id }}" id="custom-requirements-{{ ai_gen_id }}">
        <label class="ai-bulk-order-form__label-{{ ai_gen_id }}" for="custom-requirements-text-{{ ai_gen_id }}">
          Custom Requirements<span class="ai-bulk-order-form__required-{{ ai_gen_id }}">*</span>
        </label>
        <textarea
          id="custom-requirements-text-{{ ai_gen_id }}"
          name="contact[custom_requirements]"
          class="ai-bulk-order-form__textarea-{{ ai_gen_id }}"
          placeholder="Please describe your custom product requirements in detail..."
        ></textarea>
        <div class="ai-bulk-order-form__error-{{ ai_gen_id }}" id="custom-requirements-error-{{ ai_gen_id }}">
          Please describe your custom requirements
        </div>
      </div>

      <div class="ai-bulk-order-form__field-group-{{ ai_gen_id }}">
        <label class="ai-bulk-order-form__label-{{ ai_gen_id }}" for="quantity-{{ ai_gen_id }}">
          Quantity<span class="ai-bulk-order-form__required-{{ ai_gen_id }}">*</span>
        </label>
        <input
          type="number"
          id="quantity-{{ ai_gen_id }}"
          name="contact[quantity]"
          class="ai-bulk-order-form__input-{{ ai_gen_id }}"
          min="10"
          required
          aria-required="true"
        >
        <div class="ai-bulk-order-form__info-{{ ai_gen_id }}">
          Minimum order quantity: 10 units
        </div>
        <div class="ai-bulk-order-form__error-{{ ai_gen_id }}" id="quantity-error-{{ ai_gen_id }}">
          Minimum quantity is 10 units
        </div>
      </div>

      <div class="ai-bulk-order-form__field-group-{{ ai_gen_id }}">
        <label class="ai-bulk-order-form__label-{{ ai_gen_id }}" for="delivery-location-{{ ai_gen_id }}">
          Delivery Location<span class="ai-bulk-order-form__required-{{ ai_gen_id }}">*</span>
        </label>
        <textarea
          id="delivery-location-{{ ai_gen_id }}"
          name="contact[delivery_location]"
          class="ai-bulk-order-form__textarea-{{ ai_gen_id }}"
          placeholder="Enter complete delivery address..."
          required
          aria-required="true"
        ></textarea>
        <div class="ai-bulk-order-form__error-{{ ai_gen_id }}" id="delivery-location-error-{{ ai_gen_id }}">
          Please enter the delivery location
        </div>
      </div>

      <div class="ai-bulk-order-form__field-group-{{ ai_gen_id }}">
        <label class="ai-bulk-order-form__label-{{ ai_gen_id }}" for="additional-notes-{{ ai_gen_id }}">
          Additional Notes
        </label>
        <textarea
          id="additional-notes-{{ ai_gen_id }}"
          name="contact[additional_notes]"
          class="ai-bulk-order-form__textarea-{{ ai_gen_id }}"
          placeholder="Any special requests or additional information..."
        ></textarea>
      </div>

      <button
        type="submit"
        class="ai-bulk-order-form__submit-{{ ai_gen_id }}"
        id="submit-button-{{ ai_gen_id }}"
      >
        {{ block.settings.submit_button_text }}
      </button>
    {%- endform -%}
  </bulk-order-form-{{ ai_gen_id }}>
</div>

<script>
  (function() {
    class BulkOrderForm{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.form = this.querySelector('form');
        this.occasionSelect = this.querySelector('#occasion-{{ ai_gen_id }}');
        this.occasionOtherField = this.querySelector('#occasion-other-{{ ai_gen_id }}');
        this.productSelectionSelect = this.querySelector('#product-selection-{{ ai_gen_id }}');
        this.catalogProductsField = this.querySelector('#catalog-products-{{ ai_gen_id }}');
        this.customRequirementsField = this.querySelector('#custom-requirements-{{ ai_gen_id }}');
        this.quantityInput = this.querySelector('#quantity-{{ ai_gen_id }}');
        this.submitButton = this.querySelector('#submit-button-{{ ai_gen_id }}');
        this.successMessage = this.querySelector('#success-message-{{ ai_gen_id }}');
        this.formError = this.querySelector('#form-error-{{ ai_gen_id }}');
        this.notificationEmail = this.dataset.email;
        this.whatsappNumber = this.dataset.whatsapp;
      }

      connectedCallback() {
        this.setupConditionalLogic();
        this.setupFormValidation();
        this.setupFormSubmission();
      }

      setupConditionalLogic() {
        this.occasionSelect.addEventListener('change', () => {
          const occasionOtherInput = this.querySelector('#occasion-other-text-{{ ai_gen_id }}');
          if (this.occasionSelect.value === 'Other') {
            this.occasionOtherField.classList.add('active');
            occasionOtherInput.setAttribute('required', 'required');
          } else {
            this.occasionOtherField.classList.remove('active');
            occasionOtherInput.removeAttribute('required');
            occasionOtherInput.value = '';
          }
        });

        this.productSelectionSelect.addEventListener('change', () => {
          const customRequirementsTextarea = this.querySelector('#custom-requirements-text-{{ ai_gen_id }}');
          const productCheckboxes = this.querySelectorAll('.ai-bulk-order-form__product-checkbox-{{ ai_gen_id }}');

          if (this.productSelectionSelect.value === 'Choose from catalog') {
            this.catalogProductsField.classList.add('active');
            this.customRequirementsField.classList.remove('active');
            customRequirementsTextarea.removeAttribute('required');
            customRequirementsTextarea.value = '';
          } else if (this.productSelectionSelect.value === 'Custom requirements') {
            this.customRequirementsField.classList.add('active');
            this.catalogProductsField.classList.remove('active');
            customRequirementsTextarea.setAttribute('required', 'required');
            productCheckboxes.forEach(checkbox => {
              checkbox.checked = false;
            });
          } else {
            this.catalogProductsField.classList.remove('active');
            this.customRequirementsField.classList.remove('active');
            customRequirementsTextarea.removeAttribute('required');
          }
        });
      }

      setupFormValidation() {
        const inputs = this.querySelectorAll('.ai-bulk-order-form__input-{{ ai_gen_id }}, .ai-bulk-order-form__select-{{ ai_gen_id }}, .ai-bulk-order-form__textarea-{{ ai_gen_id }}');
        
        inputs.forEach(input => {
          input.addEventListener('blur', () => {
            this.validateField(input);
          });

          input.addEventListener('input', () => {
            const errorElement = this.querySelector(`#${input.id}-error`);
            if (errorElement && errorElement.classList.contains('active')) {
              this.validateField(input);
            }
          });
        });

        this.quantityInput.addEventListener('input', () => {
          const value = parseInt(this.quantityInput.value);
          if (value && value < 10) {
            this.quantityInput.value = 10;
          }
        });
      }

      validateField(field) {
        const errorElement = this.querySelector(`#${field.id}-error`);
        if (!errorElement) return true;

        let isValid = true;

        if (field.hasAttribute('required') && !field.value.trim()) {
          isValid = false;
        }

        if (field.type === 'email' && field.value) {
          const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          if (!emailRegex.test(field.value)) {
            isValid = false;
          }
        }

        if (field.id === 'quantity-{{ ai_gen_id }}') {
          const value = parseInt(field.value);
          if (!value || value < 10) {
            isValid = false;
          }
        }

        if (isValid) {
          errorElement.classList.remove('active');
        } else {
          errorElement.classList.add('active');
        }

        return isValid;
      }

      validateCatalogProducts() {
        if (this.productSelectionSelect.value !== 'Choose from catalog') {
          return true;
        }

        const productCheckboxes = this.querySelectorAll('.ai-bulk-order-form__product-checkbox-{{ ai_gen_id }}');
        const isAnyChecked = Array.from(productCheckboxes).some(checkbox => checkbox.checked);
        const errorElement = this.querySelector('#catalog-products-error-{{ ai_gen_id }}');

        if (isAnyChecked) {
          errorElement.classList.remove('active');
          return true;
        } else {
          errorElement.classList.add('active');
          return false;
        }
      }

      setupFormSubmission() {
        this.form.addEventListener('submit', async (e) => {
          e.preventDefault();

          this.formError.classList.remove('active');
          this.successMessage.classList.remove('active');

          const inputs = this.querySelectorAll('.ai-bulk-order-form__input-{{ ai_gen_id }}, .ai-bulk-order-form__select-{{ ai_gen_id }}, .ai-bulk-order-form__textarea-{{ ai_gen_id }}');
          let isFormValid = true;

          inputs.forEach(input => {
            if (!this.validateField(input)) {
              isFormValid = false;
            }
          });

          if (!this.validateCatalogProducts()) {
            isFormValid = false;
          }

          if (!isFormValid) {
            this.formError.classList.add('active');
            this.formError.scrollIntoView({ behavior: 'smooth', block: 'center' });
            return;
          }

          this.submitButton.disabled = true;
          this.submitButton.textContent = 'Submitting...';

          const formData = new FormData(this.form);
          const data = {};
          
          for (let [key, value] of formData.entries()) {
            if (key.startsWith('contact[')) {
              const fieldName = key.replace('contact[', '').replace(']', '');
              if (data[fieldName]) {
                data[fieldName] = data[fieldName] + ', ' + value;
              } else {
                data[fieldName] = value;
              }
            }
          }

          try {
            const response = await fetch(this.form.action, {
              method: 'POST',
              body: formData
            });

            if (response.ok) {
              this.sendNotifications(data);
              this.successMessage.classList.add('active');
              this.successMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
              this.form.reset();
              this.catalogProductsField.classList.remove('active');
              this.customRequirementsField.classList.remove('active');
              this.occasionOtherField.classList.remove('active');
            } else {
              throw new Error('Form submission failed');
            }
          } catch (error) {
            this.formError.textContent = 'An error occurred. Please try again.';
            this.formError.classList.add('active');
            this.formError.scrollIntoView({ behavior: 'smooth', block: 'center' });
          } finally {
            this.submitButton.disabled = false;
            this.submitButton.textContent = '{{ block.settings.submit_button_text }}';
          }
        });
      }

      sendNotifications(data) {
        const emailBody = this.formatEmailBody(data);
        const whatsappMessage = this.formatWhatsAppMessage(data);

        if (this.notificationEmail) {
          const mailtoLink = `mailto:${this.notificationEmail}?subject=New Bulk Order Request&body=${encodeURIComponent(emailBody)}`;
          window.location.href = mailtoLink;
        }

        if (this.whatsappNumber) {
          const cleanNumber = this.whatsappNumber.replace(/\D/g, '');
          const whatsappLink = `https://wa.me/${cleanNumber}?text=${encodeURIComponent(whatsappMessage)}`;
          window.open(whatsappLink, '_blank');
        }
      }

      formatEmailBody(data) {
        let body = 'BULK ORDER REQUEST\n\n';
        body += '='.repeat(50) + '\n\n';
        body += `Name: ${data.name || 'N/A'}\n`;
        body += `Email: ${data.email || 'N/A'}\n`;
        body += `Phone: ${data.phone || 'N/A'}\n`;
        body += `Company: ${data.company || 'N/A'}\n\n`;
        body += `Occasion: ${data.occasion || 'N/A'}\n`;
        if (data.occasion_other) {
          body += `Occasion Details: ${data.occasion_other}\n`;
        }
        body += `Event Date: ${data.event_date || 'N/A'}\n\n`;
        body += `Product Selection: ${data.product_selection_type || 'N/A'}\n`;
        
        if (data.product_selection_type === 'Choose from catalog') {
          const products = [];
          for (let i = 1; i <= 6; i++) {
            if (data[`product_${i}`]) {
              products.push(data[`product_${i}`]);
            }
          }
          if (products.length > 0) {
            body += `Selected Products: ${products.join(', ')}\n`;
          }
        } else if (data.custom_requirements) {
          body += `Custom Requirements: ${data.custom_requirements}\n`;
        }
        
        body += `\nQuantity: ${data.quantity || 'N/A'} units\n`;
        body += `Delivery Location: ${data.delivery_location || 'N/A'}\n`;
        
        if (data.additional_notes) {
          body += `\nAdditional Notes: ${data.additional_notes}\n`;
        }
        
        body += '\n' + '='.repeat(50) + '\n';
        body += `Submitted: ${new Date().toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' })}`;
        
        return body;
      }

      formatWhatsAppMessage(data) {
        let message = '*NEW BULK ORDER REQUEST*\n\n';
        message += `👤 ${data.name || 'N/A'}\n`;
        message += `📧 ${data.email || 'N/A'}\n`;
        message += `📱 ${data.phone || 'N/A'}\n`;
        message += `🎉 ${data.occasion || 'N/A'}\n`;
        message += `📅 ${data.event_date || 'N/A'}\n`;
        message += `📦 Qty: ${data.quantity || 'N/A'} units\n`;
        message += `📍 ${data.delivery_location ? data.delivery_location.substring(0, 50) + '...' : 'N/A'}`;
        
        return message;
      }
    }

    customElements.define('bulk-order-form-{{ ai_gen_id }}', BulkOrderForm{{ ai_gen_id }});
  })();
</script>

