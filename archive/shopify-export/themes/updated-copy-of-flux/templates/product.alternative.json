            "margin_top": 0
          }
        },
        "collapsible_tab_2": {
          "type": "collapsible_tab",
          "settings": {
            "column": "left",
            "heading": "24/7 Support",
            "heading_size": "medium",
            "heading_tag": "h4",
            "icon": "headset",
            "no_padding": true,
            "content": "<p>Share details about your 24/7 support here. Let customers know that help is always available, whether it's answering questions, resolving issues, or providing assistance. Reassure them that they can reach out anytime, and provide contact methods like phone, email, or live chat for their convenience.</p>",
            "page": "",
            "custom_liquid": "",
            "open_first_collapsible_row": false,
            "margin_top": 0,
            "color_scheme_1": "option-1"
