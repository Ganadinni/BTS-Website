# BTS-Website — required Vercel env vars (Project Settings → Environment Variables)
# This is an INDEPENDENT Vercel project — none of these are read from
# dhanveer-core or theteaplanet-website's env; each value below is its own
# copy in THIS project, even where it's the same underlying account/org.

# Own order-of-record DB (schema `bts`). Any Neon Postgres connection string
# works — easiest is Vercel's own Storage tab → Marketplace → Neon, which
# creates one and injects this automatically. Deliberately NOT the same
# database as dhanveer-core's: that credential is marked Sensitive in Vercel
# (no reveal path anyway), and sharing it would hand this independent
# storefront write access to the whole CRM schema for the sake of one lead
# insert per order — see the Dhanveer bridge vars below for the actual,
# narrower way that's done.
DATABASE_URL=postgres://user:pass@host/db

# Razorpay — founder decision: SAME merchant account as theteaplanet.com.
# Copy the live (or test) key pair from that account; do not reuse a key from
# a different Razorpay account.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Zoho Books — founder decision: all BTS orders invoice under GFF, the same
# entity theteaplanet.com uses. Create a Zoho Self Client app (API Console)
# scoped to ZohoBooks.fullaccess.all, put its id/secret below, then connect
# once via:
#   POST /api/checkout/zoho-connect  { "key": "<BTS_ADMIN_KEY>", "code": "<grant code>" }
#   (POST body, not a query string — a query string would land in browser
#   history/access logs/Referer headers for a value with full Books access)
# The refresh token this returns is stored in bts.sync_state, not in env.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# ZOHO_ORG_GFF defaults to 60015387691 (Ganadinni Fine Foods Impex Pvt Ltd) —
# only set this if that org id ever changes.
# ZOHO_ORG_GFF=60015387691

# Guards the /api/checkout/zoho-connect admin endpoint. Any random string.
BTS_ADMIN_KEY=

# Dhanveer CRM bridge (founder requirement: every BTS order becomes/updates a
# lead in Dhanveer). Calls dhanveer-core's own guarded endpoint over HTTPS —
# no database credential involved. DHANVEER_BRIDGE_KEY must be the EXACT
# same value as dhanveer-core's own BRIDGE_API_KEY env var (set it there
# first, then copy the same value here).
DHANVEER_BRIDGE_URL=https://dhanveer-core.vercel.app
DHANVEER_BRIDGE_KEY=

# Set to "off" to disable the automatic *.neon.tech → -pooler rewrite (only
# if you're deliberately using a non-Neon or already-pooled connection).
# DB_POOLER=off
